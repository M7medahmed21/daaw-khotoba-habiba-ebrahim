{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --prod=false",
  "buildCommand": "bash build-vercel.sh",
  "outputDirectory": ".vercel/output/static",
  "framework": null,
  "build": {
    "env": {
      "BASE_PATH": "/",
      "PORT": "4173",
      "NODE_ENV": "production"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
